{
  "name": "@drxiaozhi/casty",
  "version": "1.3.2",
  "description": "TTY web browser using raw CDP and Kitty graphics protocol",
  "main": "./index.js",
  "bin": {
    "casty": "./index.js"
  },
  "scripts": {
    "start": "bun ./index.js",
    "tui": "bun ./index.js --readme-tui-zh",
    "wui": "bun ./index.js --readme-wui-zh",
    "check": "node --check ./bin/casty.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "browser",
    "tty",
    "terminal",
    "kitty",
    "cdp",
    "headless",
    "chrome"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jjtseng93/casty.git"
  },
  "homepage": "https://github.com/jjtseng93/casty",
  "author": "Dr. John (醫者小智)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  }
}
